% Satzeinstellungen 

\raggedbottom % Standart für oneside, bei twoside sieht es aber trozdem besser aus | Es wird kein vspace verwendet, dass jede Seite exakt gleichlang ist
\allowdisplaybreaks % Erlaubt Seitenumbruch bei Gleichungen


% Seitenzahleinstellungen 

\pagenumbering{arabic} % Arabisches Zahlen für Seitenzahlen


% Einstellungen für Gleichungen 

\numberwithin{equation}{section} % Die Nummerierung von Gleichungen bekommt die jeweilige Section-Nummer als Präfix


% Einstellungen für Cleveref / Manache Assistenten wollen nur Klammern, manche Klammern + Gleichung und wieder andere nur Gleichung. Einfach Auskommentieren, was man nicht brauch!

% Nur Klammern um Gleichungsnr. \cref{...} -> (1)
% \crefformat{equation}{(#2#1#3)}
% \crefrangeformat{equation}{(#3#1#4) bis (#5#2#6)}
% \crefmultiformat{equation}{(#2#1#3)}{ und (#2#1#3)}{, (#2#1#3)}{ und (#2#1#3)}

% Einstellungen für den Header/Footer 

\clearpairofpagestyles % Löscht alle alten Header und Footer definitionen
\pagestyle{scrheadings} % Kopf und Fußzeilen von scrheading aktivieren
\ohead{\textbf{\GRUPPENNR\ - \VERSUCHSNR}} % Äußerer Teil der Kopfzeile, enthält Gruppenummer und Versuchsnummer
\ihead{\VerfasserEINS\;\&\;\VerfasserZWEI} % Innerer Teil der Kopfzeile, enthält die Namen der beiden Studenten
\ofoot{\pagemark} % Äußerer Teil der Fußzeile, enthält die Seitenzahl


% Hyperref Einstellungen 

\hypersetup{
    bookmarks = true, % Literaturverzeichnis in der PDF-Datei
    colorlinks = true, % Farbige Links anstatt Boxen
    linktocpage = true, % true = Macht nur die Zahlen vom Inhaltsverzeichniss zu Links
    urlcolor  = black, % Farbe für externe Hyperlinks
    linkcolor = black, % Farbe für interne Links
    citecolor = black, % Farbe für Zitate
    filecolor = black % Farbe für verlinkte lokale Dateien
}


% Einstellungen für siunitx 

\sisetup{
	detect-weight=true, % Schaut ob der Text drumherum fett, kursiv usw ist
    detect-family=true, % Schaut welche fontfamily der text drumherum hat
    locale=DE, % Normen für Deutschland
    range-phrase={~\text{bis}~}, % was für \numrange{...}{...} verwendet wird \numrange{1}{5} -> 1 bis 5
    list-final-separator ={\;\text{und}~}, % was als letztes steht bei \numlist{1;2;3;4} -> 1, 2, 3 und 4
    separate-uncertainty=true, % Ändert die Klammernotation für Unsicherheiten zu einem +-
    per-mode = symbol-or-fraction, % m/s und \frac{m}{s} als Standard 
    sticky-per=true % Nach \per sind alle folgenden Einheiten im Nenner
}


% Einstellungen für Captions 

\captionsetup{
    font=small,            % Schriftgröße der caption kleiner machen als normale Schriftgröße
    width=0.9\textwidth,   % Breite auf 90% begrenzen (die Box wird standardmäßig zentriert)
    singlelinecheck=true,  % Einzeilige Captions zentrieren (ist Standard, hier zur Verdeutlichung)
    labelfont=bf,          % Das Label (z.B. "Abbildung 1:") fett drucken
    format=plain           % Entspricht \setcapindent{0em} (Blocksatz, zweite Zeile beginnt links unter dem Label) 
}


% Einstellung für Listen

\setlist{
  parsep=0pt, % Abstand zwischen Absätzen innerhalb eines Items
  itemsep=0.5\parskip % Abstand zwischen den Items
}


% Einstellung für plots

\pgfplotsset{
    compat=1.18, % Nutzt Kompatibilitätsmodus für pgfplots Version 1.18
    every axis/.append style={
        scaled ticks=true, % Dann kommt vor allen y-ticks bpsw. 1.2 * 10^-2, oder false und dann U in mV bspw. 
        width=0.8\linewidth, % Etwas größer als Standard, da oft passender
        grid=major, % Zeigt das Hauptgitter im Plot an
        grid style={dashed, gray!40}, % Stil des Gitters (gestrichelt, hellgrau)
        every axis label/.style={font=\small},      % Beschriftung (z.B. "Strecke s in m")
        tick label style={font=\footnotesize},      % Zahlen an den Achsen (z.B. "0.5")
        /pgf/number format/use comma, % Verwendet ein Komma als Dezimaltrennzeichen
        minor tick num=4, % Fügt 4 kleine Striche zwischen den Hauptwerten ein
        tick align=inside, % Die Achsenstriche zeigen ins Innere des Plots
        legend cell align={left}, % Lässt die Legende Linkbündig sein
        legend style={font=\footnotesize,}, % Kleinere Schriftart für die Legende
        cycle list/Dark2, % Nutzt das Farbschema 'Dark2' für aufeinanderfolgende Plots
        table/search path={messdaten/}, % Standardpfad, in dem pgfplots nach Datendateien sucht
        % Einstellungen für Fehlerbalken
        y-fehler/.style={
        error bars/.cd, % Wechselt in den Unterpfad für Fehlerbalken-Einstellungen
            y dir=both, % Fehlerbalken in beide Richtungen (oben/unten)
            y explicit, % Fehlerwerte werden explizit aus den Daten gelesen
            error mark=-, % Nutzt einen Strich als Endmarkierung des Fehlerbalkens
            error mark options={rotate=90, mark size=2pt, line width=0.6pt} % Formatiert die Endmarkierungen
        },
        % 2. Nur X-Fehler
        x-fehler/.style={
            error bars/.cd,
                x dir=both, % Fehlerbalken in beide Richtungen (links/rechts)
                x explicit, % Fehlerwerte werden explizit aus den Daten gelesen
                error mark=-, % pgfplots dreht das "-" für X-Fehler automatisch senkrecht!
                error mark options={mark size=2pt, line width=0.6pt} % Formatiert die Endmarkierungen
        },
        % 3. X- und Y-Fehler gleichzeitig
        xy-fehler/.style={
            error bars/.cd,
                y dir=both, % Fehlerbalken in Y-Richtung (oben/unten)
                y explicit, % Y-Fehlerwerte explizit aus Daten
                x dir=both, % Fehlerbalken in X-Richtung (links/rechts)
                x explicit, % X-Fehlerwerte explizit aus Daten
                error mark=-, % Endmarkierung
                error mark options={mark size=2pt, line width=0.6pt} % Formatierung
        }
    }
}


% Einstellungen für Bibelverse 

\setkomafont{dictumtext}{\itshape\small} % Formatierung für den Text des Zitats (kursiv und klein)
\setkomafont{dictumauthor}{\normalfont} % Formatierung für den Autor des Zitats (normale Schrift)
\renewcommand*\dictumwidth{.75\linewidth} % Breite des Zitats (75% der Zeilenbreite)
\renewcommand*\dictumauthorformat[1]{--- #1} % Formatierung für den Autorennamen (mit Gedankenstrich davor)
\renewcommand*\dictumrule{} % Entfernt die standardmäßige Trennlinie zwischen Zitat und Autor
