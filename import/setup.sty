% Hyperreft Einstellungen 

\hypersetup{
    colorlinks = true, %Colours links instead of ugly boxes
    linktocpage = true, %true = Macht nur die Zahlen vom Inhaltsverzeichniss zu Links
    urlcolor  = black, %Colour for external hyperlinks
    linkcolor = black, %Colour of internal links
    citecolor = black, %Colour of citations
    filecolor = black %Color of linked local files
}


% Einstellungen für siunitx 

\sisetup{
    detect-weight=true, % Schaut ob der Text drumherum fett, kursiv usw ist
    detect-family=true, % Schaut welche fontfamily der text drumherum hat
    locale=DE, % Normen für Deutschland
    range-phrase={\,bis\;}, % was für \numrange{...}{...} verwendet wird, standard - % Vielleicht Dr. Kübler fragen, ob \, mit \; ausgetauscht werden sollte
    list-final-separator ={\linebreak[0] \text{und}\,}, % was als letztes steht bei \numlist{1;2;3;4} -> 1, 2, 3 und 4
    separate-uncertainty=true, % Ändert die Klammernotation für Unsicherheiten mit einem +-
    per-mode = symbol-or-fraction % m/s und \frac{m}{s} als standart
}


% Einstellungen für Caption 

\captionsetup{
    font=small, % Kleinere Schriftart für Captions
    singlelinecheck=true, % Falls Caption kleiner ist als eine Zeile wird bei false die caption linkszentrisch gesetzt, bei true in der mitte
    width=0.9\textwidth % Caption wird max. 90% der Größe der Textbreite sein
}


% Einstellung für Listen

\setlist{
  parsep=0pt, % Abstand zwischen Absätzen innerhalb eines Items
  itemsep=0.5\parskip % Abstand zwischen den Items
}