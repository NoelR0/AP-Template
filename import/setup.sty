\allowdisplaybreaks % Erlaubt Seitenumbruch bei Gleichungen


% Seitenzahleinstellungen 

\pagenumbering{arabic} % Arabisches Zahlen für Seitenzahlen


% Einstellungen für Gleichungen 

\numberwithin{equation}{section} % Die Nummerierung von Gleichungen bekommt die jeweilige Section-Nummer als PrÃ¤fix


% Einstellungen für den Header/Footer 

\clearpairofpagestyles % Löscht alle alten Header und Footer definitionen
\pagestyle{scrheadings}%Kopf und FuÃŸzeilen
\ohead{\textbf{\GRUPPENNR\ - \VERSUCHSNR}} %Header oben links auf linker Seite (ungerade Seitenzahl) und oben rechts auf rechter Seite (gerade Seitenzahl), beinhaltet gruppennummer und VersuchskÃ¼rzel. Im Fall eine einseitigen Dokuments: Header oben rechts
\ihead{\VerfasserEINS\;\&\;\VerfasserZWEI} %Header oben rechts auf linker Seite und oben links auf rechter Seite. Beinhaltet die Namen der Verfasser. Im Fall eine einseitigen Dokuments: Header oben links!
